<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- iPhone and iPad. Hotspot Configuration lets Shutterlink join the camera's own Wi-Fi network
     (NEHotspotConfiguration), from its QR code or its name and password, so a saved camera
     connects in one tap. Access Wi-Fi Information lets it check iOS really switched to the camera's
     network before talking to it. The Mac app has its own entitlements (Shutterlink-Mac.entitlements). -->
<dict>
	<key>com.apple.developer.networking.HotspotConfiguration</key>
	<true/>
	<key>com.apple.developer.networking.wifi-info</key>
	<true/>
</dict>
</plist>
