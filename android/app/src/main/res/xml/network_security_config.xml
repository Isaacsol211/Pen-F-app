<?xml version="1.0" encoding="utf-8"?>
<!-- Cameras only speak plain HTTP on their own Wi-Fi (192.168.x.x), and their addresses can't be
     listed as domains, so cleartext is allowed. The app never talks to the internet. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
